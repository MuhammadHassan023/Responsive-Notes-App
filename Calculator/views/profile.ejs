<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>My Profile Settings</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 flex items-center justify-center h-screen">
    <div class="bg-white p-10 rounded-[30px] shadow-2xl w-full max-w-md border-t-8 border-blue-600">
        <div class="text-center mb-8">
            <h2 class="text-3xl font-black text-gray-800">Account Settings</h2>
            <p class="text-gray-400 mt-2 text-sm">Update your Username & Password</p>
        </div>

        <form action="/profile/update" method="POST">
            <div class="mb-5">
                <label class="block text-gray-600 font-bold mb-2 ml-1 text-xs uppercase">Username</label>
                <input type="text" name="newName" value="<%= user.name %>" class="w-full p-4 border-2 border-gray-100 rounded-2xl outline-none focus:border-blue-400 capitalize font-bold" required>
            </div>

            <div class="mb-8">
                <label class="block text-gray-600 font-bold mb-2 ml-1 text-xs uppercase">Password</label>
                <input type="password" name="newPassword" value="<%= user.password %>" class="w-full p-4 border-2 border-gray-100 rounded-2xl outline-none focus:border-blue-400 font-bold" required>
            </div>

            <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-black py-4 rounded-2xl shadow-lg transition-all active:scale-95">
                Save Changes
            </button>
        </form>

        <div class="mt-6 text-center">
            <a href="/" class="text-gray-400 font-bold hover:text-blue-600 text-sm">← Back to Dashboard</a>
        </div>
    </div>
</body>
</html>